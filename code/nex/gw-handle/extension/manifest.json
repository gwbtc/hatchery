{
  "manifest_version": 3,
  "name": "gw-handle",
  "version": "0.1.0",
  "description": "Cookies and browser control for a paired urbit ship.",
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "tabGroups",
    "debugger",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "gw-handle"
  }
}